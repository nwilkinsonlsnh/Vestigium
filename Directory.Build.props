<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Vestigium.Logging' and '$(MSBuildProjectName)' != 'Vestigium.Logging.Tests' and '$(MSBuildProjectName)' != 'Vestigium.Logging.Demo'">
    <PackageReference Include="Vestigium.Logging" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
